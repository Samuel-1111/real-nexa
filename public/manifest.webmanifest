{
  "id": "/",
  "name": "NEXA — Your Personal Assistant",
  "short_name": "NEXA",
  "description": "NEXA is your personal assistant for tasks, reminders, notes, planning and AI conversations.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "orientation": "portrait-primary",
  "background_color": "#020817",
  "theme_color": "#020817",
  "lang": "en-NG",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Talk to NEXA",
      "short_name": "NEXA",
      "url": "/home?tab=assistant",
      "icons": [
        {
          "src": "/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Tasks",
      "short_name": "Tasks",
      "url": "/home?tab=tasks",
      "icons": [
        {
          "src": "/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Reminders",
      "short_name": "Reminders",
      "url": "/home?tab=reminders",
      "icons": [
        {
          "src": "/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
